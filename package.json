{
  "name": "@moonjellydigital/oxfmt-config",
  "version": "1.0.0",
  "description": "Oxfmt shareable config",
  "keywords": [
    "oxfmt",
    "oxfmt-config"
  ],
  "homepage": "https://github.com/moonjellydigital/oxfmt-config",
  "license": "MIT",
  "author": "Camille Spain <camille@camillespain.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonjellydigital/oxfmt-config.git"
  },
  "files": [
    "./index.json",
    "./CHANGELOG.md"
  ],
  "type": "module",
  "main": "index.json",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "bun test",
    "prepare": "husky || 0",
    "tsc:ci": "tsc",
    "fmt:ci": "oxfmt --check .",
    "lint:ci": "oxlint"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "oxfmt": ">=0.73.0 <1.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
